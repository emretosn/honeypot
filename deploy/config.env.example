# Copy to deploy/config.env and fill in. config.env is gitignored.
# All deploy/*.sh scripts source this file. These are the only values you set by hand;
# everything else is derived to match the repo naming convention.
#
# Dev/test uses LOCAL Terraform state — no remote backend, no jump VM. The remote backend
# is introduced later in the CI/CD stage (see bootstrap/).

# --- Required ---
SUBSCRIPTION_ID=""                        # az account show --query id -o tsv
VERIFIED_DOMAIN="REPLACE.onmicrosoft.com" # a verified Entra domain for decoy UPNs

# --- Naming (defaults match the rest of the repo) ---
ENVN="dev"
REGION="westeurope"
REGION_CODE="weu"
MARKER="hp"
