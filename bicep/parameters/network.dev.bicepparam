using '../network.bicep'

param location = 'westeurope'
param regionCode = 'weu'

// From the foundation deployment output. deploy/network.sh fills the subscription id for you.
param workspaceId = '/subscriptions/01169db8-9786-45a8-8878-de556ca253c4/resourceGroups/rg-core-ops-weu/providers/Microsoft.OperationalInsights/workspaces/log-core-ops-weu'

// Simulated production environment (hub + representative production spoke) built alongside the
// honeypot. The honeypot spoke denies egress to prodSpokeAddressPrefix.
param hubAddressPrefix = '10.0.0.0/16'
param prodSpokeNamePrefix = 'erp-prod'
param prodSpokeAddressPrefix = '10.10.0.0/16'
param prodStorageAccountName = 'sterpprod32548273'

// Honeypot spoke (the product). Production-looking decoy names, NO honeypot marker.
param spokeNamePrefix = 'core-prod'
param spokeAddressPrefix = '10.20.0.0/16'
param keyVaultName = 'kv-core-prod-136d'
param storageAccountName = 'stcoreprod32548272'

// Private decoy VM (no public IP, nothing internet-facing) so the RG looks like a real workload
// (network + compute + storage + secrets) rather than a bare Key Vault.
param decoyVmSshPublicKey = 'ssh-rsa  sysadmin@core-prod-app01'
param decoyVmCustomDataBase64 = ''
